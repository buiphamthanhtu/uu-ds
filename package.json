{
  "name": "uu-ds",
  "version": "1.0.0",
  "description": "ÚÙ Design System cho web: component React + CSS thuần, token, UU icon (bản công khai: icon component dùng cố định + texture).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
